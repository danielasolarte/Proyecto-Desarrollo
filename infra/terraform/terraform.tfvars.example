# Copia este archivo como terraform.tfvars (git lo ignora). Aquí no van
# secretos.
#
# E5: con este archivo basta con terraform init, plan y apply (sin los
# scripts de PowerShell). Si usas deploy/gcp/e4/tf.ps1, el proyecto lo toma
# de deploy/gcp/e4/proyecto.ps1 y la etiqueta de -Tag.

project_id = "mi-proyecto"
region     = "us-central1"

# Commit corto de las imágenes publicadas (frontend, backend, worker,
# migraciones).
image_tag = "a1b2c3d"

# Cloud Function de validación (E5). Debe quedar en true: el worker ya no
# valida, así que con false las cargas pasarían sin validar.
funcion_validar = true

# Correos del grupo: pueden ver el proyecto, los registros y las métricas,
# publicar imágenes y encender o apagar Cloud SQL.
equipo = [
  "correo1@example.com",
  "correo2@example.com",
]

# Correos del equipo docente: solo lectura.
docentes = [
  "docente@example.com",
]
