# nginx del frontend (E4). Plantilla: el entrypoint de la imagen oficial
# reemplaza ${PORT}, ${BACKEND_URL} y ${NGINX_RESOLVER} al arrancar.
server {
    listen ${PORT};
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    # Salud del propio frontend (no toca el backend).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API: mismo origen que la SPA. Con la URL en una variable, nginx pasa la
    # ruta completa (/api/v1/...) y resuelve el host en cada solicitud.
    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_http_version 1.1;
        # Cloud Run enruta por el Host: debe ser el del backend, con SNI.
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        client_max_body_size 10m;
    }

    # Archivos con hash en el nombre: se guardan en caché para siempre.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location = /version.json {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Rutas de la SPA (/cursos/..., /profesor/...): siempre index.html, que
    # nunca se guarda en caché para que una versión nueva se vea de inmediato.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
