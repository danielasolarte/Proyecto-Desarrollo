# Configuracion NO sensible del worker para la plantilla del grupo (metadato
# mooc-config). Los secretos (DATABASE_URL, S3_ACCESS_KEY, S3_SECRET_KEY) no
# van aqui: los lee cada VM de Secret Manager al arrancar.
# 07-grupo-workers.ps1 reemplaza los valores __ENTRE_GUIONES__.
REDIS_ADDR=__REDIS_ADDR__
S3_ENDPOINT=storage.googleapis.com
S3_BUCKET=__S3_BUCKET__
S3_USE_SSL=true
S3_REGION=us-central1
WORKER_WORKDIR=/tmp/media
# 2 por VM, igual que la correccion C4 de la E2 (comparabilidad del
# Escenario 2). Lo que cambia en la E3 es el numero de VM.
WORKER_CONCURRENCY=2
# Menor que mooc-detener-s de la plantilla (330 s).
WORKER_SHUTDOWN_TIMEOUT_SECONDS=300
WORKER_HEALTH_ADDR=:8081
DB_MAX_CONNS=5
DB_MIN_CONNS=0
