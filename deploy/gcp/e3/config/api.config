# Configuracion NO sensible de la API para la plantilla del grupo (metadato
# mooc-config). Los secretos (DATABASE_URL, S3_ACCESS_KEY, S3_SECRET_KEY) no
# van aqui: los lee cada VM de Secret Manager al arrancar.
# 03-grupo-api.ps1 reemplaza los valores __ENTRE_GUIONES__.
PORT=8080
REDIS_ADDR=__REDIS_ADDR__
SMTP_ADDR=__SMTP_ADDR__
S3_ENDPOINT=storage.googleapis.com
S3_BUCKET=__S3_BUCKET__
S3_USE_SSL=true
S3_REGION=us-central1
AUTH_COOKIE_ENABLED=true
CSRF_ENABLED=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_NAME=mooc_session
CSRF_COOKIE_NAME=mooc_csrf
CSRF_HEADER_NAME=X-CSRF-Token
SESSION_COOKIE_MAX_AGE_SECONDS=86400
DB_MAX_CONNS=5
DB_MIN_CONNS=0
HEALTH_TIMEOUT_MS=1500
SHUTDOWN_DRAIN_SECONDS=10
SHUTDOWN_TIMEOUT_SECONDS=20
