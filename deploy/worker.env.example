WORKER_IMAGE=us-central1-docker.pkg.dev/proyecto1-entrega2-desarrollo/mooc-e2/mooc-e2-worker:latest
DATABASE_URL=postgres://mooc-postgres:CAMBIAR_CLAVE@CAMBIAR_HOST_CLOUD_SQL:5432/mooc?sslmode=require
REDIS_ADDR=redis:6379
S3_ENDPOINT=storage.googleapis.com
S3_BUCKET=CAMBIAR_NOMBRE_DEL_BUCKET_GCS
S3_USE_SSL=true
S3_REGION=us-central1
S3_ACCESS_KEY=CAMBIAR_LLAVE_HMAC_ACCESS_ID
S3_SECRET_KEY=CAMBIAR_LLAVE_HMAC_SECRET
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
WORKER_WORKDIR=/tmp/media
WORKER_CONCURRENCY=5
# Apagado ordenado: al recibir SIGTERM se espera hasta este tiempo a los
# trabajos activos. Debe ser mayor que un trabajo y menor que mooc-detener-s.
WORKER_SHUTDOWN_TIMEOUT_SECONDS=300
# GET /health para la autorreparacion del grupo de workers.
WORKER_HEALTH_ADDR=:8081
DB_MAX_CONNS=5
DB_MIN_CONNS=0
