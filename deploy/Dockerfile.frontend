# Imagen del frontend de la E4 (Cloud Run mooc-frontend).
#
# 1. Compila la SPA de React con Vite (mismo comando que el CI).
# 2. La sirve con nginx, que además reenvía /api/* al backend: frontend y
#    API quedan en el mismo origen, así que las cookies de sesión y el CSRF
#    funcionan sin CORS (decisión 3 del plan de la E4).
#
# BACKEND_URL (https://mooc-backend-...run.app) lo pone Terraform como
# variable de entorno; nginx la sustituye al arrancar.
#
#   docker build -f deploy/Dockerfile.frontend --build-arg APP_COMMIT=<commit> -t mooc-e4-frontend .

# ---------- build ----------
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
ARG APP_COMMIT=local
ENV APP_COMMIT=${APP_COMMIT}
RUN npm run build \
 && printf '{"commit":"%s","fecha_utc":"%s"}\n' "$APP_COMMIT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > dist/version.json

# ---------- runtime ----------
FROM nginx:1.27-alpine
# Cloud Run envía el tráfico al puerto de PORT (8080 por defecto).
ENV PORT=8080 \
    BACKEND_URL=http://api:8080 \
    NGINX_ENVSUBST_FILTER="^(PORT|BACKEND_URL|NGINX_RESOLVER)$"
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/nginx/15-resolver.envsh /docker-entrypoint.d/15-resolver.envsh
RUN chmod +x /docker-entrypoint.d/15-resolver.envsh \
 && rm -f /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
