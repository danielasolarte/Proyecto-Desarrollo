# ==========================================
# BASE DE DATOS (PostgreSQL)
# ==========================================
POSTGRES_USER=mooc
POSTGRES_PASSWORD=mooc
POSTGRES_DB=mooc
POSTGRES_PORT=5432

# ==========================================
# CACHE Y COLAS (Redis)
# ==========================================
REDIS_PORT=6379

# ==========================================
# ALMACENAMIENTO DE ARCHIVOS (MinIO / S3)
# ==========================================
MINIO_ROOT_USER=mooc
MINIO_ROOT_PASSWORD=mooc12345
MINIO_BUCKET=mooc-media
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# URL para que el cliente (Postman/Frontend) acceda externamente
MINIO_PUBLIC_URL=http://localhost:9000
# Host:puerto (SIN esquema) que la API firma en las URLs prefirmadas que
# recibe ese mismo cliente externo. "minio:9000" (el que usa la API para
# hablar con MinIO dentro de docker-compose) no resuelve fuera de esa red,
# por eso hace falta este valor aparte para Postman/navegador.
MINIO_PUBLIC_ENDPOINT=localhost:9000

# ==========================================
# CORREO Y ANTIVIRUS
# ==========================================
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
CLAMAV_PORT=3310

# ==========================================
# SERVICIOS APLICACIÓN (API / Worker)
# ==========================================
API_PORT=8080
S3_USE_SSL=false