    {
      "name": "7. Estudiante: control de acceso por inscripcion",
      "item": [
        {
          "name": "Registrar estudiante",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('estudiante registrado o ya existia', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('verificationToken', pm.response.json().verification_token_dev);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"full_name\": \"Estudiante de Prueba\"\n}"
