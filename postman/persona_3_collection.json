            "url": {
              "raw": "{{baseUrl}}/uploads/{{uploadSessionId}}/parts/1/url",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "uploads",
                "{{uploadSessionId}}",
                "parts",
                "1",
                "url"
              ]
            },
            "description": "El cliente 'reconecta' y pide de nuevo la URL de la misma parte -- pedirla otra vez no cuenta como una parte nueva, la decide S3/MinIO cuando de verdad reciba el PUT."
          },
          "response": []
