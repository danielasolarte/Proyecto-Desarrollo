{
  "info": {
    "name": "MOOC - Modulo Multimedia (Persona 3)",
    "description": "Flujo completo del modulo de multimedia: identidad, autoria de curso/recurso, carga multipart reanudable con interrupcion real, encolamiento y procesamiento asincrono (HLS), casos negativos de checksum y MIME real, publicacion del curso, y control de acceso a la reproduccion segun inscripcion del estudiante. Cada request guarda en variables de coleccion lo que la siguiente necesita.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "adminEmail",
      "value": "admin@mooc.local"
    },
    {
      "key": "adminPassword",
      "value": "AdminPass123"
    },
    {
      "key": "teacherEmail",
      "value": "profesor@mooc.local"
    },
    {
      "key": "teacherPassword",
      "value": "TeacherPass123"
    },
    {
      "key": "studentEmail",
      "value": "estudiante@mooc.local"
    },
    {
      "key": "studentPassword",
      "value": "StudentPass123"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "teacherToken",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "verificationToken",
      "value": ""
    },
    {
      "key": "courseId",
      "value": ""
    },
    {
      "key": "versionId",
      "value": ""
    },
    {
      "key": "moduleId",
      "value": ""
    },
    {
      "key": "unitId",
      "value": ""
    },
    {
      "key": "resourceId",
      "value": ""
    },
    {
      "key": "resourceIdChecksumFail",
      "value": ""
    },
    {
      "key": "resourceIdMimeFail",
      "value": ""
    },
    {
