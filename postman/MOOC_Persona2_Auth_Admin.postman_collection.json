  "item": [
    {
      "name": "0. Setup y Admin",
      "item": [
        {
          "name": "01 - Healthcheck",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API responde healthcheck', function () { pm.response.to.have.status(200); });",
                  "pm.test('status ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{health_url}}",
              "host": ["{{health_url}}"]
            }
          },
          "response": []
        },
        {
          "name": "02 - Crear primer admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bootstrap crea admin o ya existia', function () { pm.expect([201, 409]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('admin_id', body.id);",
                  "  pm.environment.set('admin_id', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\",\n  \"full_name\": \"Admin MOOC\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/bootstrap-admin",
              "host": ["{{base_url}}"],
              "path": ["auth", "bootstrap-admin"]
            }
          },
          "response": []
        },
        {
          "name": "03 - Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login admin 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('admin_token', body.token);",
                  "pm.environment.set('admin_token', body.token);",
                  "pm.collectionVariables.set('admin_id', body.user.id);",
                  "pm.environment.set('admin_id', body.user.id);",
                  "pm.test('usuario admin activo', function () {",
                  "  pm.expect(body.user.role).to.eql('admin');",
                  "  pm.expect(body.user.status).to.eql('active');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "04 - Listar usuarios admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin puede listar usuarios', function () { pm.response.to.have.status(200); });",
                  "pm.test('respuesta es arreglo', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
